VITE_FIREBASE_AUTH_DOMAIN=saferoute-f87c1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=saferoute-f87c1
VITE_FIREBASE_APP_ID=1:648220987452:web:0512d9c04e89f5488bf339
# Opcional: true usa datos simulados locales sin contactar Firebase.
VITE_DEMO_MODE=false
# Activa App Check en producción con tu clave reCAPTCHA v3:
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Geoapify para mapas, direcciones, rutas y lugares. Clave pública del navegador.
# Restringir a safeorute.vercel.app y a los orígenes de desarrollo necesarios.
VITE_GEOAPIFY_API_KEY=

# Sólo en el servidor Vercel; nunca usar el prefijo VITE_ para estas variables:
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=
# Cuenta de servicio Firebase: JSON en una sola línea. Sólo en el servidor Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opcional, sólo servidor. La integración ITS ya usa esta URL por defecto.
# No es una variable VITE_ ni requiere credenciales de operador.
ITS_BACKEND_URL=https://safeorute-its-demo.onrender.com

# Opcionales, sólo servidor: si no se indican, soporte reutiliza GOOGLE_AI_*.
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=
# Cuotas del soporte (solicitudes, no dólares; valores predeterminados).
SUPPORT_AI_USER_DAILY_LIMIT=10
SUPPORT_AI_DAILY_LIMIT=50
SUPPORT_AI_MONTHLY_LIMIT=1000
