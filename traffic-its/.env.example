# Copy to .env and fill values, or run python scripts/init_local_env.py.
# Use random hexadecimal values; the database password is inserted in a URL.
ITS_DB_PASSWORD=
ITS_API_TOKEN=

# Safe default: synthetic demo, anonymous read access to demo data only.
ITS_DEMO=true
ITS_CAMERA_CONFIG=demo.json
ITS_BIND_HOST=127.0.0.1
ITS_PORT=8000
ITS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Initial worker limits are engineering defaults, not camera-capacity promises.
ITS_WORKER_CPUS=4
ITS_WORKER_MEMORY=4g
ITS_WORKER_THREADS=2

# Optional file override. Leave blank until you have authorized footage.
ITS_VIDEO_DIRECTORY=
ITS_VIDEO_FILENAME=
# Optional RTSP override. Set a real value only in ignored .env/secret storage.
ITS_CAMERA_SOURCE=
