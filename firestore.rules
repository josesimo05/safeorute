rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function isModerator() {
   return signedIn()
    && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider != 'anonymous'
    && exists(/databases/$(database)/documents/reportModerators/$(request.auth.uid))
    && get(/databases/$(database)/documents/reportModerators/$(request.auth.uid)).data.active == true;
  }
  // The opt-in pilot requires guest submissions through the private server API.
  // Its Admin SDK writes bypass client rules; no identity enters public reports.
  function allowedDirectReporter() {
   return signedIn() && (request.auth.token.firebase.sign_in_provider != 'anonymous'
    || !exists(/databases/$(database)/documents/systemPolicies/reporting)
    || get(/databases/$(database)/documents/systemPolicies/reporting).data.requireGuestIdentity != true);
  }
  function validReport(d) {
   return d.keys().hasOnly(['category','description','lat','lng','occurredAt','status','source','createdAt'])
    && d.keys().hasAll(['category','description','lat','lng','occurredAt','status','source','createdAt'])
    && d.category in ['Robo','Intento de robo','Poca iluminación','Espacio abandonado','Bache','Otro']
    && d.description is string && d.description.size() >= 12 && d.description.size() <= 600
    && d.lat is number && d.lat >= -90 && d.lat <= 90
    && d.lng is number && d.lng >= -180 && d.lng <= 180
    && d.occurredAt is string && d.occurredAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$')
    && d.status == 'pending' && d.source == 'community' && d.createdAt == request.time;
  }
  function publicReportShape(d) {
   return d.keys().hasOnly(['category','description','lat','lng','occurredAt','status','source','createdAt'])
    && d.keys().hasAll(['category','description','lat','lng','occurredAt','status','source','createdAt'])
    && d.category in ['Robo','Intento de robo','Poca iluminación','Espacio abandonado','Bache','Otro']
    && d.description is string && d.description.size() >= 12 && d.description.size() <= 600
    && d.lat is number && d.lat >= -90 && d.lat <= 90
    && d.lng is number && d.lng >= -180 && d.lng <= 180
    && d.occurredAt is string && d.occurredAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$')
    && d.source == 'community' && d.createdAt is timestamp;
  }
  function matchingReview(id, status) {
   let d = getAfter(/databases/$(database)/documents/reportReviews/$(id)).data;
   return d.keys().hasOnly(['reportId','moderatorUid','status','reviewedAt'])
    && d.keys().hasAll(['reportId','moderatorUid','status','reviewedAt'])
    && d.reportId == id && d.moderatorUid == request.auth.uid
    && d.status == status && d.reviewedAt == request.time;
  }
  function matchingWithdrawal(id) {
   let d = getAfter(/databases/$(database)/documents/reportWithdrawals/$(id)).data;
   return d.keys().hasOnly(['reportId','moderatorUid','status','withdrawnAt'])
    && d.keys().hasAll(['reportId','moderatorUid','status','withdrawnAt'])
    && d.reportId == id && d.moderatorUid == request.auth.uid
    && d.status == 'withdrawn' && d.withdrawnAt == request.time;
  }
  match /reports/{id} {
   allow read: if resource.data.status == 'approved' || isModerator();
   allow create: if allowedDirectReporter() && validReport(request.resource.data)
    && getAfter(/databases/$(database)/documents/submissionLimits/$(request.auth.uid)).data.lastReport == id
    && getAfter(/databases/$(database)/documents/submissionLimits/$(request.auth.uid)).data.at == request.time;
   // Review and withdrawal can change only status, with their own private,
   // append-only audit record created atomically. A prior review is immutable.
   allow update: if isModerator()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && ((resource.data.status == 'pending'
      && request.resource.data.status in ['approved','rejected']
      && (request.resource.data.status == 'rejected' || publicReportShape(request.resource.data))
      && !exists(/databases/$(database)/documents/reportReviews/$(id))
      && matchingReview(id, request.resource.data.status))
     || (resource.data.status == 'approved'
      && request.resource.data.status == 'withdrawn'
      && !exists(/databases/$(database)/documents/reportWithdrawals/$(id))
      && matchingWithdrawal(id)));
   allow delete: if false;
  }
  match /reportModerators/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /reportReviews/{id} {
   allow read: if isModerator();
   allow create: if isModerator()
    && request.resource.data.keys().hasOnly(['reportId','moderatorUid','status','reviewedAt'])
    && request.resource.data.keys().hasAll(['reportId','moderatorUid','status','reviewedAt'])
    && request.resource.data.reportId == id
    && request.resource.data.moderatorUid == request.auth.uid
    && request.resource.data.status in ['approved','rejected']
    && request.resource.data.reviewedAt == request.time
    && get(/databases/$(database)/documents/reports/$(id)).data.status == 'pending'
    && getAfter(/databases/$(database)/documents/reports/$(id)).data.status == request.resource.data.status
    && getAfter(/databases/$(database)/documents/reports/$(id)).data.diff(get(/databases/$(database)/documents/reports/$(id)).data).affectedKeys().hasOnly(['status']);
   allow update, delete: if false;
  }
  match /reportWithdrawals/{id} {
   allow read: if isModerator();
   allow create: if isModerator()
    && request.resource.data.keys().hasOnly(['reportId','moderatorUid','status','withdrawnAt'])
    && request.resource.data.keys().hasAll(['reportId','moderatorUid','status','withdrawnAt'])
    && request.resource.data.reportId == id
    && request.resource.data.moderatorUid == request.auth.uid
    && request.resource.data.status == 'withdrawn'
    && request.resource.data.withdrawnAt == request.time
    && get(/databases/$(database)/documents/reports/$(id)).data.status == 'approved'
    && getAfter(/databases/$(database)/documents/reports/$(id)).data.status == 'withdrawn'
    && getAfter(/databases/$(database)/documents/reports/$(id)).data.diff(get(/databases/$(database)/documents/reports/$(id)).data).affectedKeys().hasOnly(['status']);
   allow update, delete: if false;
  }
  match /submissionLimits/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create, update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['at','lastReport'])
    && request.resource.data.at == request.time
    && request.resource.data.lastReport is string
    && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.lastReport)).data.createdAt == request.time
    && (!exists(/databases/$(database)/documents/submissionLimits/$(uid)) || request.time >= resource.data.at + duration.value(60,'s'));
   allow delete: if false;
  }
  match /{document=**} {allow read,write: if false;}
 }
}
